<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AutoDeploy launchd 등록 파일.

  맥미니에 설치:
    1. 이 파일을 ~/Library/LaunchAgents/com.connecteve.autodeploy.plist 로 복사
    2. 아래 경로(__USER__, __INSTALL_DIR__)를 실제 값으로 치환
    3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.connecteve.autodeploy.plist
    4. launchctl print gui/$(id -u)/com.connecteve.autodeploy 로 상태 확인

  로그:
    ~/Library/Logs/autodeploy/stdout.log
    ~/Library/Logs/autodeploy/stderr.log

  중지 / 재시작:
    launchctl bootout gui/$(id -u)/com.connecteve.autodeploy
    launchctl kickstart -k gui/$(id -u)/com.connecteve.autodeploy
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.connecteve.autodeploy</string>

    <key>ProgramArguments</key>
    <array>
        <string>__INSTALL_DIR__/.venv/bin/python</string>
        <string>-m</string>
        <string>autodeploy</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__INSTALL_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Apple Silicon 의 Homebrew 는 /opt/homebrew/bin 이다. 이게 없으면
             hubctl preflight 가 ansible-playbook / aws 를 못 찾는다.
             Intel 이면 그 경로가 없을 뿐 해가 없다. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>ko_KR.UTF-8</string>
        <key>LC_ALL</key>
        <string>ko_KR.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/__USER__/Library/Logs/autodeploy/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/__USER__/Library/Logs/autodeploy/stderr.log</string>

    <!-- 재시작 백오프 (실패 후 최소 10초 대기). KeepAlive와 함께 사용. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
