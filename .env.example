# AutoDeploy 환경변수 예시
# .env로 복사: cp .env.example .env && chmod 600 .env
# 실제 시크릿은 .env에만, git에 커밋 금지 (.gitignore 적용됨)

# --- Slack ---
# Bot Token (xoxb-...)
SLACK_BOT_TOKEN=

# App-Level Token for Socket Mode (xapp-...)
SLACK_APP_TOKEN=

# 봇이 동작하는 채널 ID (C로 시작)
SLACK_CHANNEL_ID=

# 명령 사용 허가된 Slack user ID (쉼표 구분, U로 시작)
AUTODEPLOY_ALLOWED_USERS=

# --- 타겟 서버 SSH ---
# 계정 (기본 connecteve)
SSH_USER=connecteve
# 패스워드
SSH_PASSWORD=

# --- Bitbucket (gateway-infra-next 클론용) ---
BITBUCKET_USER=youngwoochon
BITBUCKET_APP_PASSWORD=

# --- 경로 ---
# SQLite 위치 (macOS 관행)
AUTODEPLOY_DB_PATH=~/Library/Application Support/autodeploy/state.db

# deployment_types config
AUTODEPLOY_CONFIG_PATH=config/deployment_types.yaml

# --- Site (frontend/site-management) 자동 병원 등록 ---
# 비워두면 site_register 단계는 skip된다 (기존 워크플로 영향 없음).
# on-premise 케이스: 타겟 서버의 Frontend NodePort + Host:localhost로 접근.
# hybrid 케이스: SITE_CLOUD_BASE_URL로 직접 접근 (기본 dev 게이트웨이).
SITE_ADMIN_EMAIL=
SITE_ADMIN_PASSWORD=
SITE_CLOUD_BASE_URL=https://dev-gateway.connecteve.com
SITE_API_ENV=dev

# --- Jira (생산관리 프로젝트) — product_register 단계용 ---
# 비워두면 product_register 단계를 skip (기존 워크플로 영향 없음).
JIRA_BASE_URL=https://connecteve.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_KEY=PMFM

# --- 표준 NodePort (gateway-infra-next에서 고정) ---
# install 스크립트가 [INFO] X URL을 출력하지 않아도 이 포트로 Slack/API 호출이 동작.
# 환경별 차이 생기면 .env로 override.
PORT_FRONTEND=8000
PORT_TEMPORAL=8001
PORT_WEBPACS=8002

# --- 기타 ---
LOG_LEVEL=INFO

# ── 웹 콘솔 / hubctl (v2) ───────────────────────────────────────────
# hub-provisioning 저장소 경로. hubctl 은 항상 이 디렉터리에서 실행된다.
HUBCTL_REPO_PATH=~/hub-provisioning
# ansible become(sudo) 비밀번호. 비우면 SSH_PASSWORD 를 쓴다
# (타겟이 connecteve 계정 공통이라 동일). ANSIBLE_BECOME_PASSWORD_FILE 로 전달되며
# 0600 임시 파일에 담겨 작업 종료 즉시 삭제된다.
BECOME_PASSWORD=

# ── 웹 콘솔 (v2) ────────────────────────────────────────────────────
# 데몬에 웹 콘솔을 함께 띄울지
WEB_ENABLED=false
# 바인드 주소. 기본은 루프백(127.0.0.1) — 사내 LAN 이나 Tailscale 에 열려면
# 0.0.0.0 으로 명시한다. 이 콘솔은 타겟 서버에 sudo 로 변경을 가할 수 있으므로
# 노출 범위는 명시적 선택이어야 한다.
#
# Tailscale 주소(100.x.y.z)를 여기에 직접 적으면 tailnet 으로만 열려 더 좁지만,
# 부팅 직후 Tailscale 이 인터페이스를 올리기 전에 데몬이 먼저 뜨면 바인드가
# 실패한다. 그 실패는 Slack 봇을 죽이지 않고 조용히 넘어가므로(웹만 안 뜬다)
# 사람이 알아채고 데몬을 다시 띄우기 전까지 콘솔이 죽어 있다. 0.0.0.0 을 권한다.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# 세션 쿠키 만료(일). 슬라이딩 갱신 없음 — 지나면 재로그인.
SESSION_TTL_DAYS=14
# HTTPS 리버스 프록시 뒤에 둘 때만 true (쿠키에 Secure 플래그).
WEB_SECURE_COOKIE=false
# 신뢰하는 프록시 뒤에서 X-Forwarded-For 를 클라이언트 IP 로 쓸지.
# 직결이면 false 로 둔다 — 켜두면 클라이언트가 헤더를 위조해 로그인 잠금을 우회한다.
WEB_TRUST_FORWARDED=false
# Slack 메시지에 넣을 콘솔 주소. WEB_HOST 가 0.0.0.0 이면 그건 주소가 아니라
# "모든 인터페이스"라는 뜻이라 링크로 못 쓴다 — 그 경우 여기에 명시한다.
# 예: http://100.116.199.41:8080  (맥미니 Tailscale 주소)
WEB_PUBLIC_URL=
